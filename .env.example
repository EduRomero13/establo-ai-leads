# ========================================================
# ESTABLO AI — VARIABLES DE ENTORNO
# Parrilladas El Establo - Módulo LEADS
# ========================================================

# Conexión a Microsoft SQL Server (Base: buyer)
DB_SERVER=127.0.0.1
DB_PORT=1434
DB_NAME=buyer
# Usuario de la app. Empieza con 'sa' y cambia a 'establo_app' tras
# ejecutar sql/03_CREAR_USUARIO_APP.sql (recomendado).
DB_USER=establo_app
# Contraseña del usuario 'sa' (MSSQL_SA_PASSWORD del contenedor database)
DB_PASSWORD=EstabloLeads2026!
# Contraseña de establo_app. Si existe, db.ts la prefiere sobre DB_PASSWORD.
DB_APP_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true
DB_TRUSTED_CONNECTION=false

# Inteligencia Artificial (Hermes / Gemini)
# Prioriza HERMES_API_URL si está configurado
# Hermes Agent (NousResearch) expone una API OpenAI-compatible en el puerto 8642.
# En Dokploy usa la URL interna del servicio Hermes, ej: http://hermes:8642/v1
# o su dominio público: https://hermes.tudominio.com/v1
HERMES_API_URL=http://hermes:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_MS=45000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Enlace público del formulario de captación (para contactos no registrados)
CAPTACION_URL=https://elestablo.pe/captacion

# Zona Horaria Comercial
TZ=America/Lima

# WhatsApp — Whapi.cloud (Recomendado por simplicidad)
# Si WHAPI_TOKEN está presente, el sistema usará Whapi en lugar de Meta API
WHAPI_TOKEN=
WHAPI_API_URL=https://gate.whapi.cloud
WHAPI_WEBHOOK_TOKEN=establo_whapi_webhook_secret_2026

# WhatsApp Business Platform — Cloud API Oficial (Meta)
# Configurar para recibir y enviar mensajes reales con número de Meta
WHATSAPP_DEMO_MODE=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=establo_ai_webhook_secret_2026
META_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
